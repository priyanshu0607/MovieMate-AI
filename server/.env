PORT=5000
CLIENT_ORIGIN=http://localhost:5173
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
TMDB_API_KEY=
TMDB_REGION=IN

# MovieMate stores conversations, responses, watchlist and activity locally.
# No database URL, Supabase credentials, or external database is required.

# Optional Groq reasoning layer. Ollama remains the primary autonomous agent.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_OUTPUT_TOKENS=450
MAX_AGENT_STEPS=5
MAX_LOCAL_TOOL_CHARS=5000
